---
import BlueSkyIcon from '../components/icons/blue-sky.astro';
import GitHubIcon from '../components/icons/github.astro';
import MastodonIcon from '../components/icons/mastodon.astro';

type Props = {
	reveal: boolean;
};

const { reveal } = Astro.props;

const socialLinks = [
	{
		href: 'https://bsky.app/profile/lukebennett.dev',
		icon: BlueSkyIcon,
		label: 'Blue Sky',
	},
	{
		href: 'https://github.com/lukebennett88',
		icon: GitHubIcon,
		label: 'GitHub',
	},
	{
		href: 'https://mastodon.social/@luke_bennett_',
		icon: MastodonIcon,
		label: 'Mastodon',
	},
];

const rssFeeds = [
	{
		href: '/feed.json',
		label: 'JSON Feed',
	},
	{
		href: '/feed.xml',
		label: 'XML Feed',
	},
];

const year = new Date().getFullYear();
---

<footer
	class:list={[
		'flex flex-col items-center gap-4 px-4 py-4 text-center text-white [--focus-outline-color:var(--color-white)] sm:px-6 md:py-8 lg:px-8',
		reveal
			? 'bottom-0 motion-safe:sticky motion-safe:focus-within:static'
			: 'mt-auto',
	]}
>
	<nav
		aria-label="RSS Feeds"
		class="flex flex-col items-center"
		role="navigation"
	>
		<h2>Subscribe to my RSS feed</h2>
		<ul class="flex flex-wrap items-center justify-center gap-x-4">
			{rssFeeds.map(({ label, href }) => (
				<li>
					<a
						class="underline decoration-teal-200 underline-offset-[0.15em] transition-colors duration-150 hover:decoration-white"
						href={href}
					>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<nav aria-label="Social" class="flex flex-col items-center" role="navigation">
		<ul class="flex items-center gap-4">
			{socialLinks.map(({ label, href, icon: Icon }) => (
				<li>
					<a
						class="-m-1.5 block rounded-full p-1.5 transition-colors duration-150 hover:bg-teal-900"
						href={href}
						rel="me"
					>
						<span class="sr-only">{label}</span>
						<Icon class="h-4 w-4" />
					</a>
				</li>
			))}
		</ul>
	</nav>
	<p>&copy; {year} Luke Bennett. All rights reserved.</p>
</footer>
