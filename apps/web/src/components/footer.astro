---
import BlueSkyIcon from '../components/icons/blue-sky.astro';
import GitHubIcon from '../components/icons/github.astro';
import MastodonIcon from '../components/icons/mastodon.astro';

const socialLinks = [
	{
		href: 'https://bsky.app/profile/lukebennett.dev',
		icon: BlueSkyIcon,
		label: 'Blue Sky',
	},
	{
		href: 'https://github.com/lukebennett88',
		icon: GitHubIcon,
		label: 'GitHub',
	},
	{
		href: 'https://mastodon.social/@luke_bennett_',
		icon: MastodonIcon,
		label: 'Mastodon',
	},
];

const rssFeeds = [
	{
		href: '/feed.json',
		label: 'JSON Feed',
	},
	{
		href: '/feed.xml',
		label: 'XML Feed',
	},
];

const year = new Date().getFullYear();
---

<footer class="mx-auto flex w-full max-w-4xl flex-col items-center justify-between gap-4 px-4 py-8 text-gray-700 sm:px-6 lg:px-8 dark:text-gray-400">
	<nav
		aria-label="RSS Feeds"
		class="flex flex-col items-center"
		role="navigation"
	>
		<h2>Subscribe to my RSS feed</h2>
		<ul class="flex items-center gap-4">
			{rssFeeds.map(({ label, href }) => (
				<li>
					<a
						class="underline decoration-gray-400 underline-offset-[0.15em] transition-colors duration-150 hover:text-teal-800 hover:decoration-teal-700 dark:decoration-gray-500 dark:hover:text-teal-300"
						href={href}
					>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<nav aria-label="Social" class="flex flex-col items-center" role="navigation">
		<ul class="flex items-center gap-4">
			{socialLinks.map(({ label, href, icon: Icon }) => (
				<li>
					<a
						class="-m-1.5 block rounded-full p-1.5 text-gray-500 transition-colors duration-150 hover:text-teal-700 dark:text-gray-400 dark:hover:text-teal-400"
						href={href}
						rel="me"
					>
						<span class="sr-only">{label}</span>
						<Icon class="h-4 w-4" />
					</a>
				</li>
			))}
		</ul>
	</nav>
	<p>&copy; {year} Luke Bennett. All rights reserved.</p>
</footer>
