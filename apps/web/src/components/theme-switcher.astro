---
import ThemeSelect from '../components/theme-select.astro';
---

<div class="flex flex-1 justify-end gap-4">
	<theme-select>
		<ThemeSelect
			icon="laptop"
			label="Theme"
			value="auto"
			options={[
				{ label: 'Dark', selected: false, value: 'dark' },
				{ label: 'Light', selected: false, value: 'light' },
				{ label: 'Auto', selected: true, value: 'auto' },
			]}
		/>
	</theme-select>

	<script>
		type Theme = 'auto' | 'dark' | 'light';

		class ThemeSelect extends HTMLElement {
			/** Key in `localStorage` to store color theme preference at. */
			#key = 'theme';
			#colorScheme = matchMedia('(prefers-color-scheme: light)');

			constructor() {
				super();
				this.addEventListener('change', (e) => {
					if (e.target instanceof HTMLSelectElement) {
						this.#applyTheme(this.#parseTheme(e.target.value));
					}
				});
			}

			connectedCallback() {
				this.#applyTheme(this.#loadTheme());
				this.#colorScheme.addEventListener('change', this.#onColorSchemeChange);
			}

			disconnectedCallback() {
				this.#colorScheme.removeEventListener(
					'change',
					this.#onColorSchemeChange,
				);
			}

			#onColorSchemeChange = () => {
				if (this.#loadTheme() === 'auto') this.#applyTheme('auto');
			};

			/** Get a typesafe theme string from any JS value (unknown values are coerced to `'auto'`). */
			#parseTheme(theme: unknown): Theme {
				if (theme === 'auto' || theme === 'dark' || theme === 'light') {
					return theme;
				} else {
					return 'auto';
				}
			}

			/** Get the preferred system color scheme. */
			#getPreferredColorScheme(): Theme {
				return this.#colorScheme.matches ? 'light' : 'dark';
			}

			#applyTheme(theme: Theme): void {
				const select = this.querySelector('select');
				if (select) select.value = theme;
				const template =
					document.querySelector<HTMLTemplateElement>('#theme-icons');
				const icon = template?.content.querySelector(`.${theme}`);
				const labelIcon = this.querySelector('svg.label-icon');
				if (icon && labelIcon) {
					labelIcon.replaceChildren(...icon.cloneNode(true).childNodes);
				}

				document.documentElement.classList.remove('light', 'dark');
				document.documentElement.classList.add(
					theme === 'auto' ? this.#getPreferredColorScheme() : theme,
				);
				this.#storeTheme(theme);
			}

			/** Store the user’s preference in `localStorage`. */
			#storeTheme(theme: Theme): void {
				if (typeof localStorage !== 'undefined') {
					if (theme === 'light' || theme === 'dark') {
						localStorage.setItem(this.#key, theme);
					} else {
						localStorage.removeItem(this.#key);
					}
				}
			}

			/** Load the user’s preference from `localStorage`. */
			#loadTheme(): Theme {
				const theme =
					typeof localStorage !== 'undefined' &&
					localStorage.getItem(this.#key);
				return this.#parseTheme(theme);
			}
		}

		customElements.define('theme-select', ThemeSelect);
	</script>
</div>
