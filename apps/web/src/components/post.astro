---
import type { DocumentElement } from '@keystatic/core';
import { DocumentRenderer } from '../lib/keystatic/document-renderer';
import { formatToAustralianDate } from '../lib/posts';

type Props = {
	document: Array<DocumentElement>;
	publishedAt: string;
};

const { document, publishedAt } = Astro.props;
---

<article class="mx-auto prose dark:prose-invert">
	<header class="not-prose mb-10">
		<slot name="title" />
		<time
			class="mt-3 block w-fit text-sm text-gray-600 tabular-nums dark:text-gray-400"
			datetime={publishedAt}
		>
			{formatToAustralianDate(publishedAt)}
		</time>
	</header>
	<DocumentRenderer document={document} />
</article>
