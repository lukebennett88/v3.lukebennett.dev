---
import ThemeSwitcher from '../components/theme-switcher.astro';
import { cn } from '../lib/cn';

const mainNav = [
	{ href: '/', label: 'Home' },
	{ href: '/posts', label: 'Posts' },
	{ href: '/links', label: 'Links' },
	{ href: '/blogroll', label: 'Blogroll' },
];

const pathname = Astro.url.pathname;
---

<header
	class={cn(
		'site-header sticky z-10 flex flex-wrap items-center gap-4 rounded-t-4xl bg-gray-100 px-4 pt-6 pb-3',
		'dark:bg-gray-900',
		'sm:px-6',
		'md:pt-8 md:pb-4',
		'lg:px-8',
	)}
	role="banner"
	transition:animate="initial"
	transition:name="site-header"
>
	<a
		class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:inline-block focus-visible:rounded-full focus-visible:bg-gray-200 focus-visible:px-3 focus-visible:py-1.5 focus-visible:hover:text-gray-600 dark:focus-visible:bg-teal-700 dark:focus-visible:hover:text-white"
		href="#main"
	>
		Skip to main content
	</a>
	<div class="flex flex-1 items-center">
		<a
			class={cn(
				'h-11 w-11 rounded-full bg-white p-1 font-sans shadow-sm transition-colors',
				'text-teal-700 hover:text-teal-600',
				'dark:bg-teal-600 dark:text-gray-900 dark:hover:bg-teal-500',
			)}
			href="/"
		>
			<span class="sr-only">Luke Bennett</span>
			<svg
				aria-hidden="true"
				fill="currentColor"
				fill-rule="evenodd"
				focusable="false"
				role="img"
				viewBox="0 0 24 24"
			>
				<path d="M12 24c6.627 0 12-5.373 12-12S18.627 0 12 0 0 5.373 0 12s5.373 12 12 12zm0-4.836l-4.8-2.4v-12l-2.4 1.2v12l7.2 3.6 7.2-3.6v-4.8l-2.4-1.2 2.4-1.2v-4.8l-7.2-3.6v16.8zm4.8-4.8l-2.4-1.2v4.8l2.4-1.2v-2.4zm0-7.2l-2.4-1.2v4.8l2.4-1.2v-2.4z"></path>
			</svg>
		</a>
	</div>
	<nav
		aria-label="Primary"
		class="order-last flex w-full justify-center md:order-0 md:w-auto"
		role="navigation"
	>
		<ul
			class={cn(
				'flex items-center gap-0.5 rounded-full p-1.5 text-sm font-medium shadow-inner sm:gap-2',
				'bg-gray-200 text-gray-800 ring-gray-900/5',
				'dark:bg-gray-950 dark:text-gray-200 dark:ring-gray-800',
			)}
		>
			{mainNav.map(({ label, href }) => {
				const isHighlighted =
					href === '/'
						? pathname === href || pathname === '/index.html'
						: pathname?.startsWith(href);
				return (
					<li class="group relative focus-within:z-10">
						{isHighlighted ? (
							<span
								aria-hidden="true"
								class={cn(
									'absolute inset-0 rounded-full shadow-sm transition-colors duration-150',
									'bg-gray-100 group-hover:bg-white',
									'dark:bg-gray-800 dark:group-hover:bg-gray-700',
								)}
								transition:animate="initial"
								transition:name="nav-pill"
							/>
						) : null}
						<a
							aria-current={isHighlighted ? 'page' : undefined}
							class={cn(
								!isHighlighted && [
									'hover:text-teal-700 active:text-teal-600',
									'dark:hover:text-teal-400 dark:active:text-teal-300',
								],
								'relative inline-block rounded-full px-[clamp(0.5rem,6vw-0.55rem,1rem)] py-1.5 text-xs font-medium transition-colors duration-150',
							)}
							href={href}
							transition:animate="initial"
							transition:name={`nav-${label.toLowerCase()}`}
						>
							{label}
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
	<ThemeSwitcher />
</header>
