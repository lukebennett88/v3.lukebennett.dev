---
import Layout from '../layouts/layout.astro';
import { DocumentRenderer } from '../lib/keystatic/document-renderer';
import { reader } from '../lib/keystatic/reader';

const page = await reader.singletons.blogroll.readOrThrow();
const content = await page.content();
---

<Layout title="Blogroll">
	<div class="mx-auto prose dark:prose-invert">
		<DocumentRenderer document={content} />
		<ul>
			{page.blogs.map((blog) => (
				<li>
					{blog.links.length > 0 && (
						<ul class="not-prose float-end ms-4 flex gap-1.5 font-mono text-xs/[1.75rem]">
							{blog.links.filter(Boolean).map((link) => (
								<li>
									<a
										href={link.href}
										class="text-gray-600 underline decoration-gray-400 underline-offset-[0.15em] transition-colors duration-150 hover:text-teal-800 dark:text-gray-400 dark:decoration-gray-500 dark:hover:text-teal-300"
									>
										{`#${link.label}`}
									</a>
								</li>
							))}
						</ul>
					)}
					<a href={blog.href}>{blog.label}</a>
					{blog.rss && (
						<a
							href={blog.rss}
							class="ms-1 text-sm text-gray-600 dark:text-gray-400"
						>
							(RSS)
						</a>
					)}
				</li>
			))}
		</ul>
	</div>
</Layout>
