---
import Layout from '../../layouts/layout.astro';
import { cn } from '../../lib/cn';
import { reader } from '../../lib/keystatic/reader';
import { formatToAustralianDate, sortPosts } from '../../lib/posts';

const posts = sortPosts(await reader.collections.posts.all()).filter(
	function (post) {
		return process.env.NODE_ENV === 'production' ? !post.entry.isDraft : true;
	},
);
---

<Layout title="Posts">
	<div class="mx-auto flex max-w-content flex-col gap-4">
		<div class="prose dark:prose-invert">
			<h1>Posts</h1>
			<p class="text-balance">
				Longer form content.
				<br />
				For interesting links with limited commentary,{' '}
				<a href="links">check out the links section</a> instead.
			</p>
		</div>
		<ul class="flex max-w-content flex-col gap-2 sm:gap-3" role="list">
			{posts.map(({ slug, entry }) => (
				<li
					class={cn(
						'relative -mx-2 rounded-xl bg-white px-3 py-4 wrap-break-word shadow-sm sm:-mx-4 sm:p-4 dark:bg-gray-800',
						entry.isDraft &&
							'outline-2 -outline-offset-2 outline-yellow-500 outline-dashed',
					)}
				>
					<h2 class="text-xl/tight font-bold text-balance text-gray-900 sm:text-2xl/tight dark:text-white">
						<a
							class="underline decoration-teal-700 decoration-from-font underline-offset-[0.15em] transition-colors duration-150 after:absolute after:inset-0 after:rounded-[inherit] hover:text-teal-800 dark:decoration-teal-500 dark:hover:text-teal-300"
							href={`/posts/${slug}`}
						>
							{entry.title}
						</a>
					</h2>
					<time
						class="mt-2 block w-fit text-sm text-gray-600 tabular-nums dark:text-gray-400"
						datetime={entry.publishedAt}
					>
						{formatToAustralianDate(entry.publishedAt)}
					</time>
				</li>
			))}
		</ul>
	</div>
</Layout>
