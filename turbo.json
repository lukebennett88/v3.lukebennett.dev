{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": [
		"**/.env.*local",
		"packages/tsconfig/*.json",
		"vite.config.ts"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["NODE_ENV"],
			"outputs": ["dist/**", ".netlify/v1/**"]
		},
		"check:types": {},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
